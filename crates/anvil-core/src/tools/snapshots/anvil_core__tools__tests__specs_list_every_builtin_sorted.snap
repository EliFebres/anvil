---
source: crates/anvil-core/src/tools/mod.rs
expression: specs
---
[
  {
    "name": "edit_file",
    "description": "Replaces an exact string in a file. Fails when the old string is missing or, unless replace_all is true, when it occurs more than once; include more surrounding context to make it unique.",
    "parameters": {
      "description": "Arguments of the `edit_file` tool.",
      "properties": {
        "new": {
          "description": "Replacement text.",
          "type": "string"
        },
        "old": {
          "description": "Exact text to replace. Must occur exactly once unless replace_all is set.",
          "type": "string"
        },
        "path": {
          "description": "Path of the file, relative to the project root or absolute.",
          "type": "string"
        },
        "replace_all": {
          "default": false,
          "description": "Replace every occurrence instead of requiring a unique match.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "old",
        "new"
      ],
      "type": "object"
    }
  },
  {
    "name": "glob",
    "description": "Finds files whose path relative to the search root matches a glob pattern. `*` does not cross directory separators; use `**/` to recurse. Honors .gitignore and skips hidden files. Returns paths relative to the project root, sorted.",
    "parameters": {
      "description": "Arguments of the `glob` tool.",
      "properties": {
        "path": {
          "default": null,
          "description": "Directory to search, relative to the project root or absolute. Default: the project root.",
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "Glob such as `**/*.rs` or `src/*.toml`, matched against paths relative to the search root.",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    }
  },
  {
    "name": "grep",
    "description": "Searches file contents for a regular expression. Up to 50 matches come back as `path:line:text` with 3 lines of context around each (`path-line-text`, groups separated by `--`) and, above each group, the enclosing function or item with its line range; more matches come back as bare `path:line:text` lines. Honors .gitignore, skips hidden and binary files. Optionally restrict to a directory and a file glob.",
    "parameters": {
      "description": "Arguments of the `grep` tool.",
      "properties": {
        "glob": {
          "default": null,
          "description": "Only search files matching this glob, such as `*.rs` (by file name) or `src/**/*.rs` (by path).",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "File or directory to search, relative to the project root or absolute. Default: the project root.",
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "Regular expression (Rust regex syntax) matched against each line.",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    }
  },
  {
    "name": "list_dir",
    "description": "Lists the entries of one directory, sorted by name, with a trailing slash on subdirectories. Not recursive; use glob to find files by pattern.",
    "parameters": {
      "description": "Arguments of the `list_dir` tool.",
      "properties": {
        "path": {
          "default": null,
          "description": "Directory to list, relative to the project root or absolute. Default: the project root.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "outline",
    "description": "Shows a file's structure without its bodies: imports, then each function, method, class, struct, enum, trait, impl, module, table or heading with its line range and first doc line. On a directory, does the same for every source file, honoring .gitignore. Use it to learn what a file or directory defines and where, at a fraction of the cost of reading it.",
    "parameters": {
      "description": "Arguments of the `outline` tool.",
      "properties": {
        "depth": {
          "default": null,
          "description": "Nesting levels to show; 1 shows top-level items only. Default 2.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "description": "File or directory, relative to the project root or absolute.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "read_file",
    "description": "Reads UTF-8 text files and returns their lines prefixed with 1-based line numbers. Pass `path` (with optional offset and limit) for one file, or `files` with up to 20 {path, offset?, limit?} entries to read several files or ranges in one call; each then comes under a `==> path <==` header.",
    "parameters": {
      "description": "Arguments of the `read_file` tool.",
      "properties": {
        "files": {
          "description": "Several files or line ranges to read in one call, instead of `path`.",
          "items": {
            "description": "One file or line range in a multi-file read.",
            "properties": {
              "limit": {
                "default": null,
                "description": "Maximum number of lines to return. Default 2000.",
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "offset": {
                "default": null,
                "description": "First line to return, counting from 1. Default 1.",
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "path": {
                "description": "Path of the file, relative to the project root or absolute.",
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "limit": {
          "default": null,
          "description": "Maximum number of lines to return. Default 2000.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": null,
          "description": "First line to return, counting from 1. Default 1.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "Path of one file, relative to the project root or absolute. Omit when\npassing `files`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "shell",
    "description": "Runs a command in the project shell (PowerShell on Windows, sh elsewhere) from the project root and returns its combined stdout and stderr followed by the exit code. Output is capped at 30 KB; the full output is kept in the session folder.",
    "parameters": {
      "description": "Arguments of the `shell` tool.",
      "properties": {
        "command": {
          "description": "The command line to run.",
          "type": "string"
        },
        "timeout_s": {
          "default": null,
          "description": "Seconds before the command is killed. Default 120, maximum 600.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  },
  {
    "name": "write_file",
    "description": "Writes the given content to a file, creating parent directories and replacing any existing contents. Prefer edit_file for small changes to existing files.",
    "parameters": {
      "description": "Arguments of the `write_file` tool.",
      "properties": {
        "content": {
          "description": "The complete new contents.",
          "type": "string"
        },
        "path": {
          "description": "Path of the file, relative to the project root or absolute.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "type": "object"
    }
  }
]
