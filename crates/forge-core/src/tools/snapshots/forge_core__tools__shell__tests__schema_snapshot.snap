---
source: crates/forge-core/src/tools/shell.rs
expression: ShellTool.schema()
---
{
  "description": "Arguments of the `shell` tool.",
  "properties": {
    "command": {
      "description": "The command line to run.",
      "type": "string"
    },
    "timeout_s": {
      "default": null,
      "description": "Seconds before the command is killed. Default 120, maximum 600.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "command"
  ],
  "type": "object"
}
