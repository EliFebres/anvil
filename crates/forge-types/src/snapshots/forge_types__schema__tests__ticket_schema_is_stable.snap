---
source: crates/forge-types/src/schema.rs
expression: ticket_schema()
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ticket",
  "description": "A request for the factory to improve forge.\n\nTickets are stored as `tickets/open/<id>.toml`. Call [`Ticket::validate`]\nafter deserializing; serde checks the shape, the validator checks the\ndata boundary.",
  "type": "object",
  "properties": {
    "acceptance": {
      "description": "Checks the factory must make pass.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "description": "When the ticket was created, RFC 3339.",
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "description": "Ids into forge's telemetry, not content.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TelemetryRef"
      }
    },
    "id": {
      "description": "Unique, time-ordered id. Also the file stem.",
      "type": "string"
    },
    "kind": {
      "description": "What kind of improvement is wanted.",
      "$ref": "#/$defs/TicketKind"
    },
    "origin": {
      "description": "Who created it.",
      "$ref": "#/$defs/TicketOrigin"
    },
    "priority": {
      "description": "How urgent the ticket is.",
      "$ref": "#/$defs/Priority"
    },
    "repro": {
      "description": "A synthetic reproduction. Never project code.",
      "type": [
        "string",
        "null"
      ]
    },
    "spec": {
      "description": "The interface wanted: CLI flags, tool JSON schema, skill name and trigger.",
      "type": "string"
    },
    "status": {
      "description": "Where the ticket is in its lifecycle.",
      "$ref": "#/$defs/TicketStatus"
    },
    "symptom": {
      "description": "What went wrong or what was missing, in plain words.",
      "type": "string"
    },
    "title": {
      "description": "One line, at most [`MAX_TITLE_CHARS`] characters.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "created_at",
    "kind",
    "title",
    "symptom",
    "spec",
    "acceptance",
    "priority",
    "status",
    "origin"
  ],
  "$defs": {
    "Priority": {
      "description": "How urgently a ticket should be worked.",
      "oneOf": [
        {
          "description": "Blocks normal use; work it first.",
          "type": "string",
          "const": "p0"
        },
        {
          "description": "Important, not blocking.",
          "type": "string",
          "const": "p1"
        },
        {
          "description": "Nice to have.",
          "type": "string",
          "const": "p2"
        }
      ]
    },
    "TelemetryRef": {
      "description": "Reference to one event in forge's own telemetry store.\n\nCarries the id only, never the event content, so a ticket can point at\nevidence without leaking what the user was working on.",
      "type": "string"
    },
    "TicketKind": {
      "description": "What kind of improvement a ticket asks for.",
      "oneOf": [
        {
          "description": "A new or changed tool.",
          "type": "string",
          "const": "tool"
        },
        {
          "description": "A new or changed skill.",
          "type": "string",
          "const": "skill"
        },
        {
          "description": "A prompt change.",
          "type": "string",
          "const": "prompt"
        },
        {
          "description": "A change to the agent loop itself.",
          "type": "string",
          "const": "loop"
        },
        {
          "description": "A change to cross-project memory.",
          "type": "string",
          "const": "memory"
        },
        {
          "description": "A change to a model or provider.",
          "type": "string",
          "const": "model"
        },
        {
          "description": "Something that is simply broken.",
          "type": "string",
          "const": "bug"
        }
      ]
    },
    "TicketOrigin": {
      "description": "Who created the ticket.",
      "oneOf": [
        {
          "description": "Drafted by forge's own telemetry.",
          "type": "string",
          "const": "cli"
        },
        {
          "description": "Drafted by the factory, for example from a failed review.",
          "type": "string",
          "const": "factory"
        },
        {
          "description": "Written by a person.",
          "type": "string",
          "const": "human"
        }
      ]
    },
    "TicketStatus": {
      "description": "Where a ticket is in its lifecycle.",
      "oneOf": [
        {
          "description": "Drafted by forge in `tickets/draft/`, not yet submitted.",
          "type": "string",
          "const": "draft"
        },
        {
          "description": "Waiting in `tickets/open/`.",
          "type": "string",
          "const": "open"
        },
        {
          "description": "A factory worker has taken it.",
          "type": "string",
          "const": "claimed"
        },
        {
          "description": "A pull request exists and is under review.",
          "type": "string",
          "const": "in_review"
        },
        {
          "description": "Merged to trunk.",
          "type": "string",
          "const": "merged"
        },
        {
          "description": "Closed without merging.",
          "type": "string",
          "const": "rejected"
        }
      ]
    }
  }
}
