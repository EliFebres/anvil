# The worker image: the Rust toolchain pinned in rust-toolchain.toml plus what
# `just check`, the eval checks and the standing rules need (`python` for the
# docstring check). The build context is the repository
# root (.dockerignore lets in only the files below); `factory update` builds
# it, labelled with a hash of its inputs, whenever that hash changes:
#
#   podman build -t localhost/anvil-factory:latest -f deploy/nuc/Containerfile .
#
# The factory runs it with --network none; entrypoint.sh bridges the egress
# proxy's unix socket (mounted at /run/factory/proxy.sock) to localhost:3128.
# rust-lang.org is not on the egress allowlist, so rustup in the container can
# never download anything: the toolchain is read from rust-toolchain.toml here,
# at build time, and installed with every component and target it lists.
# buildpack-deps is what the official rust images build on, minus Rust.
FROM docker.io/library/buildpack-deps:bookworm

# musl-tools: musl-gcc, for the C parts of the TLS stack on the musl target.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git socat ca-certificates curl \
        musl-tools \
        python3 python-is-python3 python3-pytest python3-pandas \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# The pin is copied before the install so a change to it rebuilds this layer.
# The final versions run with auto-install off in the pin's folder, so the
# build fails here, not in a ticket, if the pin needs anything not installed.
COPY rust-toolchain.toml /usr/local/share/rust-pin/rust-toolchain.toml
RUN channel="$(sed -n 's/^channel *= *"\(.*\)"$/\1/p' /usr/local/share/rust-pin/rust-toolchain.toml)" \
    && test -n "$channel" \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal \
            --default-toolchain "$channel" \
            --component rustfmt,clippy \
            --target x86_64-unknown-linux-musl \
    && cd /usr/local/share/rust-pin \
    && export RUSTUP_AUTO_INSTALL=0 \
    && cargo --version \
    && cargo fmt --version \
    && cargo clippy --version \
    && rustup target list --installed | grep -qx x86_64-unknown-linux-musl

# just: the prebuilt binary, the same way bootstrap.sh installs it on the host.
RUN curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh \
    | bash -s -- --to /usr/local/bin

# The worktree is mounted at /work and owned by the host user; with
# `podman run --userns=keep-id:uid=1000,gid=1000` that user maps to `worker`
# here whatever its uid on the host (WORKER_UID in factory-core's sandbox.rs).
RUN useradd --uid 1000 --create-home worker \
    && mkdir -p /work /run/factory \
    && chown worker:worker /work /run/factory \
    && chmod -R a+rwX /usr/local/cargo \
    && chmod -R a+rX /usr/local/rustup

COPY deploy/nuc/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

USER worker
WORKDIR /work
ENV CARGO_TERM_COLOR=never
ENTRYPOINT ["/entrypoint.sh"]
